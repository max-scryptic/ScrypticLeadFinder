# Canonical origin of the production site, no trailing slash. Drives canonical
# URLs, og:url, the sitemap, robots.txt, llms.txt and JSON-LD @ids. On Vercel it
# falls back to the production domain, so this is only required elsewhere.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Set to 1 to send noindex from a production build (e.g. a staging host that is
# not on Vercel). Vercel preview deployments are always noindex.
SITE_NOINDEX=

# Search console ownership tokens: the content="" value of each verification
# meta tag. Leave blank to skip.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Neon Postgres connection string (use the pooled one). Apply the schema with
# `npm run db:migrate`.
DATABASE_URL=

# Companies House developer hub (https://developer.company-information.service.gov.uk).
# Create an application, then one REST key and one Streaming key. Both are free.
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_STREAM_KEY=
